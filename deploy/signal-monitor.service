[Unit]
Description=Signal Monitor API and probe scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=signal-monitor
Group=signal-monitor
WorkingDirectory=/opt/signal-monitor/current
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SIGNAL_PUBLIC_ORIGIN=https://38.92.15.50
Environment=SIGNAL_DATA_DIR=/var/lib/signal-monitor
ExecStart=/usr/local/bin/node server/production.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
StateDirectory=signal-monitor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/signal-monitor
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
